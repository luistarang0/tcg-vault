# Copiar este archivo como .env y ajustar valores. El .env NO se sube a git.

# off | observe | enforce
SECURITY_MODE=observe

# Límites de peticiones (formato N/second|minute|hour)
RATE_LIMIT_CATALOG=60/minute
RATE_LIMIT_FORMS=10/minute
RATE_LIMIT_IP=120/minute
RETRY_AFTER_SECONDS=60

# Mercado: login, pujas y polling de subastas
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_BIDS=20/minute
RATE_LIMIT_POLL=40/minute
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MIN=15

# Postgres de Neon. En local, la rama `dev` (Connect -> rama dev -> con pooling).
# En Vercel la variable la crea la integración con Neon (rama main). Sin comillas.
DATABASE_URL=
SESSION_DAYS=7

# Cloudflare Turnstile (paso 8). Claves de PRUEBA oficiales de Cloudflare:
#   sitekey 1x00000000000000000000AA  -> el widget siempre pasa
#   sitekey 3x00000000000000000000FF  -> fuerza un desafío interactivo (casilla)
#   secret  1x0000000000000000000000000000000AA -> la validación siempre pasa
#   secret  2x0000000000000000000000000000000AA -> la validación siempre falla
# En producción se reemplazan por las claves reales del panel de Cloudflare.
TURNSTILE_SITEKEY=3x00000000000000000000FF
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Carpeta del log de acceso. Vacío = server/logs (en Vercel, /tmp/tcg-vault-logs)
LOG_DIR=

# Copia de los eventos de seguridad en Postgres (tabla security_events).
# Vacío = activo solo en Vercel. 1 = también en local (cada evento conecta a Neon).
SECURITY_EVENTS_DB=
